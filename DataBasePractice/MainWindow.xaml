<Window x:Class="DataBasePractice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DataBasePractice"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="People" FontSize="26" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock Text="Select a person to edit their details. Save to keep your changes." 
                       FontSize="13" Foreground="#4B5563" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Search Bar (ALT + E) -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Label Content="S_earch" Target="{Binding ElementName=txtSearch}" 
                   Padding="0,0,0,3" FontWeight="SemiBold" TabIndex="0"/>
            <TextBox x:Name="txtSearch" Height="28" VerticalContentAlignment="Center" 
                     Padding="4,0" TextChanged="TxtSearch_TextChanged" TabIndex="1"/>
        </StackPanel>

        <!-- Sorting Buttons -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <!-- Sort by Name (ALT + N) -->
                <Button Content="Sort by _Name" Width="105" Height="28" Margin="0,0,10,0" 
                        Click="BtnSortByName_Click" TabIndex="2"/>
                <!-- Sort by Age (ALT + O) -->
                <Button Content="S_ort by Age" Width="105" Height="28" 
                        Click="BtnSortByAge_Click" TabIndex="3"/>
            </StackPanel>
            <TextBlock x:Name="lblSortStatus" Text="Sorted by last name, then first name" 
                       HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#4B5563" FontSize="12"/>
        </Grid>

        <!-- DataGrid -->
        <DataGrid x:Name="dgPeople" Grid.Row="3" Margin="0,0,0,15"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="All"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0"
                  BorderBrush="#D1D5DB"
                  BorderThickness="1"
                  TabIndex="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="2*"/>
                <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="2*"/>
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="1*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Selected Person Details Box -->
        <GroupBox Grid.Row="4" Header="Selected Person" Padding="10" Margin="0,0,0,12"
                  DataContext="{Binding SelectedItem, ElementName=dgPeople}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- First Name (ALT + F) -->
                <StackPanel Grid.Column="0">
                    <Label Content="_First Name" Target="{Binding ElementName=txtFirstName}" Padding="0,0,0,3"/>
                    <TextBox x:Name="txtFirstName" Height="26" VerticalContentAlignment="Center"
                             Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" TabIndex="5"/>
                </StackPanel>

                <!-- Last Name (ALT + L) -->
                <StackPanel Grid.Column="2">
                    <Label Content="_Last Name" Target="{Binding ElementName=txtLastName}" Padding="0,0,0,3"/>
                    <TextBox x:Name="txtLastName" Height="26" VerticalContentAlignment="Center"
                             Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" TabIndex="6"/>
                </StackPanel>

                <!-- Age (ALT + G) -->
                <StackPanel Grid.Column="4">
                    <Label Content="A_ge" Target="{Binding ElementName=txtAge}" Padding="0,0,0,3"/>
                    <TextBox x:Name="txtAge" Height="26" VerticalContentAlignment="Center"
                             Text="{Binding Age, UpdateSourceTrigger=PropertyChanged}" TabIndex="7"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,10">
            <!-- Add (ALT + A) -->
            <Button Content="_Add Person" Width="110" Height="30" Margin="0,0,10,0" 
                    Click="BtnAdd_Click" TabIndex="8"/>
            <!-- Delete (ALT + D) -->
            <Button Content="_Delete Person" Width="110" Height="30" Margin="0,0,10,0" 
                    Click="BtnDelete_Click" TabIndex="9"/>
            <!-- Save (ALT + S) -->
            <Button Content="_Save Changes" Width="110" Height="30" 
                    Click="BtnSave_Click" TabIndex="10"/>
        </StackPanel>

        <!-- Bottom Informational Text -->
        <TextBlock Grid.Row="6" Text="Click Save Changes to store additions, edits, and deletions in SQLite." 
                   FontSize="12" Foreground="#4B5563"/>
    </Grid>
</Window>
